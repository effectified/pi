{
	"name": "@effectified/pi-ai",
	"version": "0.1.0",
	"description": "Pi's models in Effect: Models as a service, streams and completions as Stream and Effect, and bridges to effect/ai in both directions",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./estimate": {
			"source": "./src/estimate.ts",
			"types": "./dist/estimate.d.ts",
			"import": "./dist/estimate.js"
		},
		"./providers/*": {
			"source": "./src/providers/*.ts",
			"types": "./dist/providers/*.d.ts",
			"import": "./dist/providers/*.js"
		},
		"./testing": {
			"source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"piEffect": {
		"kind": "facade"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"effect",
		"pi",
		"ai",
		"llm"
	],
	"author": "Gunther Brunner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/effectified/pi.git",
		"directory": "packages/ai-effect"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.6.1",
		"@effectified/pi-schema": "0.1.0"
	},
	"peerDependencies": {
		"effect": "~4.1.5"
	},
	"devDependencies": {
		"@earendil-works/pi-schema": "1.6.1",
		"effect": "4.1.5",
		"vitest": "4.1.12"
	}
}
