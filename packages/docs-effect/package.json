{
	"name": "@effectified/pi-docs",
	"version": "0.3.0",
	"private": true,
	"description": "The documentation of the pi-effect packages, kept as Pi keeps its own: Markdown pages and a docs.json catalog, a site built from them, and skills that lead agents to the pages",
	"type": "module",
	"exports": {
		"./package.json": "./package.json"
	},
	"piEffect": {
		"kind": "docs"
	},
	"pi": {
		"skills": [
			"./skills"
		]
	},
	"files": [
		"dist",
		"docs",
		"skills",
		"bin",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "node ../../scripts/package-files.mjs clean dist && node src/node/build.ts",
		"test": "vitest --run"
	},
	"keywords": [
		"effect",
		"pi",
		"docs",
		"skills",
		"pi-package"
	],
	"author": "Gunther Brunner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/effectified/pi.git",
		"directory": "packages/docs-effect"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"devDependencies": {
		"marked": "18.0.11",
		"vitest": "4.1.12"
	}
}
