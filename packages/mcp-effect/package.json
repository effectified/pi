{
	"name": "@effectified/pi-mcp",
	"version": "0.2.0",
	"description": "pi-mcp in Effect: MCP clients and transports as scoped resources, requests as Effects, notifications as Streams, OAuth sign-in, and one tagged error union",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./oauth": {
			"source": "./src/oauth/index.ts",
			"types": "./dist/oauth/index.d.ts",
			"import": "./dist/oauth/index.js"
		},
		"./testing": {
			"source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"piEffect": {
		"kind": "facade"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"effect",
		"pi",
		"mcp",
		"model-context-protocol"
	],
	"author": "Gunther Brunner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/effectified/pi.git",
		"directory": "packages/mcp-effect"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-mcp": "1.6.1"
	},
	"peerDependencies": {
		"effect": "~4.1.5"
	},
	"devDependencies": {
		"@effectified/pi-ai": "0.2.0",
		"effect": "4.1.5",
		"vitest": "4.1.12"
	}
}
