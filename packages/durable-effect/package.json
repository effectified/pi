{
	"name": "@effectified/pi-durable",
	"version": "0.2.0",
	"description": "Pi Durable in Effect: the durable agent harness as Layers, Effects and Streams",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./env": {
			"source": "./src/env/index.ts",
			"types": "./dist/env/index.d.ts",
			"import": "./dist/env/index.js"
		},
		"./env/node": {
			"source": "./src/env/node.ts",
			"types": "./dist/env/node.d.ts",
			"import": "./dist/env/node.js"
		},
		"./codemode": {
			"source": "./src/codemode.ts",
			"types": "./dist/codemode.d.ts",
			"import": "./dist/codemode.js"
		},
		"./tool-search": {
			"source": "./src/tool-search.ts",
			"types": "./dist/tool-search.d.ts",
			"import": "./dist/tool-search.js"
		},
		"./tools": {
			"source": "./src/tools.ts",
			"types": "./dist/tools.d.ts",
			"import": "./dist/tools.js"
		},
		"./images": {
			"source": "./src/images/index.ts",
			"types": "./dist/images/index.d.ts",
			"import": "./dist/images/index.js"
		},
		"./images/fit": {
			"source": "./src/images/fit.ts",
			"types": "./dist/images/fit.d.ts",
			"import": "./dist/images/fit.js"
		},
		"./images/node": {
			"source": "./src/images/node.ts",
			"types": "./dist/images/node.d.ts",
			"import": "./dist/images/node.js"
		},
		"./images/cloudflare": {
			"source": "./src/images/cloudflare.ts",
			"types": "./dist/images/cloudflare.d.ts",
			"import": "./dist/images/cloudflare.js"
		},
		"./storage/memory": {
			"source": "./src/storage/memory.ts",
			"types": "./dist/storage/memory.d.ts",
			"import": "./dist/storage/memory.js"
		},
		"./storage/indexeddb": {
			"source": "./src/storage/indexeddb.ts",
			"types": "./dist/storage/indexeddb.d.ts",
			"import": "./dist/storage/indexeddb.js"
		},
		"./storage/jsonl": {
			"source": "./src/storage/jsonl/index.ts",
			"types": "./dist/storage/jsonl/index.d.ts",
			"import": "./dist/storage/jsonl/index.js"
		},
		"./storage/jsonl/node": {
			"source": "./src/storage/jsonl/node.ts",
			"types": "./dist/storage/jsonl/node.d.ts",
			"import": "./dist/storage/jsonl/node.js"
		},
		"./storage/store": {
			"source": "./src/storage/store.ts",
			"types": "./dist/storage/store.d.ts",
			"import": "./dist/storage/store.js"
		},
		"./storage/sqlite": {
			"source": "./src/storage/sqlite/index.ts",
			"types": "./dist/storage/sqlite/index.d.ts",
			"import": "./dist/storage/sqlite/index.js"
		},
		"./storage/sqlite/cloudflare": {
			"source": "./src/storage/sqlite/cloudflare.ts",
			"types": "./dist/storage/sqlite/cloudflare.d.ts",
			"import": "./dist/storage/sqlite/cloudflare.js"
		},
		"./storage/sqlite/node": {
			"source": "./src/storage/sqlite/node.ts",
			"types": "./dist/storage/sqlite/node.d.ts",
			"import": "./dist/storage/sqlite/node.js"
		},
		"./testing": {
			"source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"piEffect": {
		"kind": "facade"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"effect",
		"pi",
		"durable",
		"agents"
	],
	"author": "Gunther Brunner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/effectified/pi.git",
		"directory": "packages/durable-effect"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-durable": "1.6.1",
		"@effectified/pi-ai": "0.2.0",
		"@effectified/pi-chord": "0.2.0",
		"@effectified/pi-schema": "0.2.0"
	},
	"peerDependencies": {
		"effect": "~4.1.5"
	},
	"devDependencies": {
		"@earendil-works/chord": "1.6.1",
		"@earendil-works/pi-ai": "1.6.1",
		"@earendil-works/pi-schema": "1.6.1",
		"@effect/sql-sqlite-bun": "4.1.5",
		"@effect/sql-sqlite-node": "4.1.5",
		"@effectified/pi-codemode": "0.2.0",
		"effect": "4.1.5",
		"esbuild": "0.28.2",
		"fake-indexeddb": "6.2.6",
		"miniflare": "5.20261023.2-beta",
		"vitest": "4.1.12"
	}
}
