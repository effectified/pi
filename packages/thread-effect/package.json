{
	"name": "@effectified/pi-thread",
	"version": "0.3.0",
	"description": "An agent thread for Pi Durable in Effect, composed of the pi-effect plugins: guarded, budgeted, recorded and reviewed, with subagents and swarms, in one process or as a Rivet actor per thread",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rivet": {
			"source": "./src/rivet.ts",
			"types": "./dist/rivet.d.ts",
			"import": "./dist/rivet.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"piEffect": {
		"kind": "composition"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"effect",
		"pi",
		"agents",
		"rivet"
	],
	"author": "Gunther Brunner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/effectified/pi.git",
		"directory": "packages/thread-effect"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "1.6.1",
		"@earendil-works/pi-durable": "1.6.1",
		"@effectified/pi-ai": "0.3.0",
		"@effectified/pi-approvals": "0.3.0",
		"@effectified/pi-budget": "0.3.0",
		"@effectified/pi-durable": "0.3.0",
		"@effectified/pi-durable-rivet": "0.3.0",
		"@effectified/pi-guard": "0.3.0",
		"@effectified/pi-recorder": "0.3.0",
		"@effectified/pi-review": "0.3.0",
		"@effectified/pi-router": "0.3.0",
		"@effectified/pi-schema": "0.3.0",
		"@effectified/pi-search": "0.3.0",
		"@effectified/pi-subagent": "0.3.0",
		"@effectified/pi-swarm": "0.3.0",
		"@effectified/pi-telemetry": "0.3.0"
	},
	"peerDependencies": {
		"effect": "~4.1.5",
		"rivetkit": "~3.1.1"
	},
	"devDependencies": {
		"@effect/sql-sqlite-bun": "4.1.5",
		"@effect/sql-sqlite-node": "4.1.5",
		"effect": "4.1.5",
		"rivetkit": "3.1.1",
		"vitest": "4.1.12"
	}
}
