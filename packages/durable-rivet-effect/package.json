{
	"name": "@gunta/pi-durable-rivet-effect",
	"version": "0.1.0",
	"description": "A Pi Durable harness inside a Rivet actor in Effect: actor SQLite as storage, actor schedules as wake-ups, actor forks with onFork hygiene",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./node": {
			"source": "./src/node.ts",
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		},
		"./bun": {
			"source": "./src/bun.ts",
			"types": "./dist/bun.d.ts",
			"import": "./dist/bun.js"
		},
		"./testing": {
			"source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"import": "./dist/testing/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"piEffect": {
		"kind": "host"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"effect",
		"pi"
	],
	"author": "Gunther Brunner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/gunta/pi-effect.git",
		"directory": "packages/durable-rivet-effect"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/chord": "1.6.0",
		"@earendil-works/pi-ai": "1.6.0",
		"@earendil-works/pi-durable": "1.6.0",
		"@gunta/pi-ai-effect": "0.1.0",
		"@gunta/pi-durable-effect": "0.1.0"
	},
	"peerDependencies": {
		"effect": "~4.1.5",
		"rivetkit": "~3.1.1"
	},
	"devDependencies": {
		"effect": "4.1.5",
		"rivetkit": "3.1.1",
		"vitest": "4.1.12"
	}
}
