{
	"name": "@effectified/pi-codemode",
	"version": "0.2.0",
	"description": "Pi's code mode in Effect: sandboxes as scoped resources, a run as an Effect and its events as a Stream, tools as Effects",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./cloudflare": {
			"source": "./src/cloudflare.ts",
			"types": "./dist/cloudflare.d.ts",
			"import": "./dist/cloudflare.js"
		},
		"./declarations": {
			"source": "./src/declarations.ts",
			"types": "./dist/declarations.d.ts",
			"import": "./dist/declarations.js"
		},
		"./portable": {
			"source": "./src/portable.ts",
			"types": "./dist/portable.d.ts",
			"import": "./dist/portable.js"
		},
		"./source": {
			"source": "./src/source.ts",
			"types": "./dist/source.d.ts",
			"import": "./dist/source.js"
		},
		"./worker": {
			"source": "./src/worker.ts",
			"types": "./dist/worker.d.ts",
			"import": "./dist/worker.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"./src/worker.ts",
		"./dist/worker.js"
	],
	"piEffect": {
		"kind": "facade"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"effect",
		"pi",
		"codemode",
		"sandbox",
		"quickjs"
	],
	"author": "Gunther Brunner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/effectified/pi.git",
		"directory": "packages/codemode-effect"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-codemode": "1.6.1",
		"@effectified/pi-agent": "0.2.0"
	},
	"peerDependencies": {
		"effect": "~4.1.5"
	},
	"devDependencies": {
		"@effectified/pi-ai": "0.2.0",
		"effect": "4.1.5",
		"esbuild": "0.28.2",
		"miniflare": "5.20261023.2-beta",
		"vitest": "4.1.12"
	}
}
