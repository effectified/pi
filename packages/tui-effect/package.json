{
	"name": "@effectified/pi-tui",
	"version": "0.1.0",
	"description": "The terminal UI in Effect: a running TUI and terminal as scoped resources, keyboard and terminal input as Streams, renders and updates as Effects",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"piEffect": {
		"kind": "facade"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"effect",
		"pi"
	],
	"author": "Gunther Brunner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/effectified/pi.git",
		"directory": "packages/tui-effect"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-tui": "1.6.1"
	},
	"peerDependencies": {
		"effect": "~4.1.5"
	},
	"devDependencies": {
		"@xterm/headless": "5.5.0",
		"effect": "4.1.5",
		"vitest": "4.1.12"
	}
}
