{
	"name": "@effectified/pi-guard",
	"version": "0.3.0",
	"description": "Guards for Pi Durable agents in Effect: a tool allow-list per conversation, verbs that can never be registered, and argument rules, failing closed",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"piEffect": {
		"kind": "plugin"
	},
	"files": [
		"dist",
		"README.md"
	],
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json",
		"test": "vitest --run",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"keywords": [
		"effect",
		"pi"
	],
	"author": "Gunther Brunner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/effectified/pi.git",
		"directory": "packages/guard-effect"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"dependencies": {
		"@earendil-works/pi-durable": "1.6.1",
		"@effectified/pi-durable": "0.3.0"
	},
	"peerDependencies": {
		"effect": "~4.1.5"
	},
	"devDependencies": {
		"@effect/sql-sqlite-bun": "4.1.5",
		"@effect/sql-sqlite-node": "4.1.5",
		"@effectified/pi-ai": "0.3.0",
		"effect": "4.1.5",
		"vitest": "4.1.12"
	}
}
